    local espCache = {}  
  
    local function clearESP()  
        for _, drawings in pairs(espCache) do  
            for _, d in pairs(drawings) do  
                if d.Remove then d:Remove() end  
            end  
        end  
        espCache = {}  
    end  
  
    local function createESPForPlayer(player)  
        local drawings = {}  
        if ESPBoxEnabled then  
            local box = Drawing.new("Square")  
            box.Thickness = 2  
            box.Color = Color3.fromRGB(255, 0, 0)  
            box.Filled = false  
            box.Transparency = 1  
            drawings.Box = box  
        end  
        if ESPLineEnabled then  
            local line = Drawing.new("Line")  
            line.Thickness = 1  
            line.Color = Color3.new(0, 0, 0)  
            line.Transparency = 1  
            drawings.Line = line  
        end  
        espCache[player] = drawings  
    end  
  
    local function updateESP()  
        clearESP()  
        if not (ESPBoxEnabled or ESPLineEnabled) then return end  
        for _, player in ipairs(Players:GetPlayers()) do  
            if player ~= LocalPlayer and player.Character and player.Character:FindFirstChild("HumanoidRootPart") then  
                if not espCache[player] then createESPForPlayer(player) end  
                local drawings = espCache[player]  
                local root = player.Character.HumanoidRootPart  
                local head = player.Character:FindFirstChild("Head")  
                local humanoid = player.Character:FindFirstChildOfClass("Humanoid")  
                if humanoid and humanoid.Health > 0 and root and head then  
                    local pos, onScreen = Camera:WorldToViewportPoint(root.Position)  
                    if drawings.Box then  
                        if onScreen then  
                            local size = (head.Position - root.Position).Magnitude  
                            local height = size * 2.5  
                            local width = size * 1.5  
                            drawings.Box.Size = Vector2.new(width, height)  
                            drawings.Box.Position = Vector2.new(pos.X - width/2, pos.Y - height/2)  
                            drawings.Box.Visible = true  
                        else  
                            drawings.Box.Visible = false  
                        end  
                    end  
                    if drawings.Line then  
                        if onScreen then  
                            drawings.Line.From = Vector2.new(pos.X, Camera.ViewportSize.Y)  
                            drawings.Line.To = Vector2.new(pos.X, pos.Y)  
                            drawings.Line.Visible = true  
                        else  
                            drawings.Line.Visible = false  
                        end  
                    end  
                else  
                    if drawings.Box then drawings.Box.Visible = false end  
                    if drawings.Line then drawings.Line.Visible = false end  
                end  
            end  
        end  
    end  
  

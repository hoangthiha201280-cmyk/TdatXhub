            CrosshairH.Visible = true  
            CrosshairV.Visible = true  
            CrosshairH.From = Vector2.new(center.X - POVRadius, center.Y)  
            CrosshairH.To = Vector2.new(center.X + POVRadius, center.Y)  
            CrosshairV.From = Vector2.new(center.X, center.Y - POVRadius)  
            CrosshairV.To = Vector2.new(center.X, center.Y + POVRadius)  
        else  
            POVCircle.Visible = false  
            CrosshairH.Visible = false  
            CrosshairV.Visible = false  
        end  
    end  
  
